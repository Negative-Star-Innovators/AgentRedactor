#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

// Self-release builds stamp the real version: the vcxproj passes
// AR_VERSION_TEXT (x.y.z, UNQUOTED — embedded quotes do not survive the
// MSBuild -> rc.exe command line; the value silently compiled in empty and
// the exe read as 0.0.0.0) and AR_VERSION_QUAD (x,y,z,0 — computed by
// build.ps1 because the rc preprocessor cannot split strings). Store/MSIX
// builds define neither and fall back to 1.0.0.0.
#define AR_STR2(x) #x
#define AR_STR(x) AR_STR2(x)
#ifdef AR_VERSION_QUAD
#define AR_VERSIONINFO_QUAD AR_VERSION_QUAD
#else
#define AR_VERSIONINFO_QUAD 1,0,0,0
#endif
#ifdef AR_VERSION_TEXT
#define AR_VERSIONINFO_TEXT AR_STR(AR_VERSION_TEXT)
#else
#define AR_VERSIONINFO_TEXT "1.0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     AR_VERSIONINFO_QUAD
PRODUCTVERSION  AR_VERSIONINFO_QUAD
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Agent Redactor"
            VALUE "FileDescription",  "Agent Redactor - AI Traffic PII Protection Proxy"
            VALUE "FileVersion",      AR_VERSIONINFO_TEXT
            VALUE "InternalName",     "AgentRedactor"
            VALUE "LegalCopyright",   "Agent Redactor"
            VALUE "OriginalFilename", "AgentRedactor.exe"
            VALUE "ProductName",      "Agent Redactor"
            VALUE "ProductVersion",   AR_VERSIONINFO_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDI_APP_ICON ICON "app.ico"
