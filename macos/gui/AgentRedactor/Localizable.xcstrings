    "MacPassword_DisableMessage" : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy sal gevra word om met Touch ID of jou Mac-wagwoord te verifieer voordat beskerming gedeaktiveer word."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُطلب منك التحقق باستخدام Touch ID أو كلمة مرور Mac قبل تعطيل الحماية."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qoruma söndürülməzdən əvvəl Touch ID və ya Mac parolunuzla doğrulamaq lazım gələcək."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ще бъдете помолени да се удостоверите с Touch ID или паролата за Mac, преди защитата да бъде забранена."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před deaktivací ochrany budete vyzváni k ověření pomocí Touch ID nebo hesla k Macu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bliver bedt om at godkende med Touch ID eller din Mac-adgangskode, før beskyttelsen deaktiveres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werden aufgefordert, sich mit Touch ID oder Ihrem Mac-Kennwort zu verifizieren, bevor der Schutz deaktiviert wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα σας ζητηθεί να πιστοποιηθείτε με Touch ID ή τον κωδικό πρόσβασης του Mac πριν απενεργοποιηθεί η προστασία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will be asked to verify with Touch ID or your Mac password before protection is disabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se le pedirá que se verifique con Touch ID o la contraseña de su Mac antes de desactivar la protección."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enne kaitse keelamist palutakse teil autentida Touch ID või Maci parooliga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinua pyydetään todentamaan Touch ID:llä tai Macisi salasanalla ennen suojauksen poistamista käytöstä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hihilingin sa iyong i-verify gamit ang Touch ID o iyong Mac password bago i-disable ang proteksyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous devrez vous vérifier avec Touch ID ou le mot de passe de votre Mac avant de désactiver la protection."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za a nemi ka tabbata da Touch ID ko kalmar sirrin Mac kafin a kashe kariya."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תתבקש לאמת באמצעות Touch ID או סיסמת ה-Mac לפני השבתת ההגנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुरक्षा अक्षम करने से पहले आपसे Touch ID या अपने Mac पासवर्ड से सत्यापित करने को कहा जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od vas će se zatražiti da se potvrdite pomoću Touch ID-a ili lozinke za Mac prije onemogućavanja zaštite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A védelem letiltása előtt Touch ID-val vagy Mac-jelszavával kell hitelesítenie magát."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Պաշտպանությունը անջատելուց առաջ ձեզ կառաջարկվի վավերացվել Touch ID-ով կամ Mac-ի գաղտնաբառով։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda akan diminta memverifikasi dengan Touch ID atau kata sandi Mac sebelum perlindungan dinonaktifkan."
          }
        },
        "ig-NG" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ga-akpa gị ka ị kwenye site na Touch ID ma ọ bụ passwọọdụ Mac gị tupu a kwụsị nchebe ahụ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú verður beðin(n) um að auðkenna þig með Touch ID eða lykilorði Mac áður en vernd er slökkt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti verrà chiesto di verificare con Touch ID o la password del Mac prima di disabilitare la protezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保護を無効化する前に Touch ID または Mac のパスワードでの確認が求められます。"
