    "Dialog_EnableHello_Message" : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows Hello sal gebruik word om die toepassing te ontsluit. U sal gevra word om met Windows Hello te verifieer."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم استخدام Windows Hello لفتح التطبيق. سيُطلب منك التحقق باستخدام Windows Hello."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proqramın kilidini açmaq üçün Windows Hello istifadə olunacaq. Sizdən Windows Hello ilə doğrulamağınız xahiş olunacaq."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows Hello ще се използва за отключване на приложението. Ще бъдете помолени да потвърдите с Windows Hello."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K odemknutí aplikace se použije Windows Hello. Budete požádáni o ověření pomocí Windows Hello."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows Hello vil blive brugt til at låse appen op. Du bliver bedt om at bekræfte med Windows Hello."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Entsperren der App wird Windows Hello verwendet. Sie werden aufgefordert, die Überprüfung mit Windows Hello durchzuführen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Windows Hello θα χρησιμοποιηθεί για το ξεκλείδωμα της εφαρμογής. Θα σας ζητηθεί να κάνετε επαλήθευση με το Windows Hello."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows Hello will be used to unlock the app. You will be asked to verify with Windows Hello."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se utilizará Windows Hello para desbloquear la aplicación. Se le pedirá que verifique con Windows Hello."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakenduse avamiseks kasutatakse Windows Hello. Teil palutakse Windows Hello abil kinnitada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovelluksen lukituksen avaamiseen käytetään Windows Hellota. Sinua pyydetään vahvistamaan Windows Hellolla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagamitin ang Windows Hello para i-unlock ang app. Hihilingin sa iyo na mag-verify gamit ang Windows Hello."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows Hello sera utilisé pour déverrouiller l'application. Il vous sera demandé de vérifier avec Windows Hello."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za a yi amfani da Windows Hello don buɗe app. Za a umarce ku da ku tabbatar da Windows Hello."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows Hello ישמש לביטול נעילת האפליקציה. תתבקש לאמת עם Windows Hello."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप को अनलॉक करने के लिए विंडोज़ हैलो का उपयोग किया जाएगा। आपसे विंडोज़ हैलो से सत्यापित करने के लिए कहा जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows Hello koristit će se za otključavanje aplikacije. Od vas će se tražiti da potvrdite Windows Hello."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Windows Hello segítségével feloldhatja az alkalmazás zárolását. A rendszer felkéri, hogy ellenőrizze a Windows Hello segítségével."
          }
        },
