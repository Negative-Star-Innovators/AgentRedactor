    "HomePage_Logs_Disclaimer.Text" : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logs word op hierdie rekenaar gestoor. Geredigeerde logs kan steeds sensitiewe data bevat wat opsporing gemis het."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تخزين السجلات على هذا الكمبيوتر. ربما لا تزال السجلات المنقحة تحتوي على بيانات حساسة لم يتم الكشف عنها."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeydlər bu kompüterdə saxlanılır. Redaktə edilmiş jurnallar hələ də aşkarlamanın buraxılmış həssas datasını ehtiva edə bilər."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регистрационните файлове се съхраняват на този компютър. Редактираните регистрационни файлове може все още да съдържат чувствителни данни, които откриването е пропуснато."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protokoly jsou uloženy na tomto počítači. Redigované protokoly mohou stále obsahovat citlivá data, která nebyla detekována."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logs gemmes på denne pc. Redakterede logfiler kan stadig indeholde følsomme data, som registreringen er gået glip af."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem PC werden Protokolle gespeichert. Geschwärzte Protokolle enthalten möglicherweise immer noch vertrauliche Daten, die bei der Erkennung übersehen wurden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα αρχεία καταγραφής αποθηκεύονται σε αυτόν τον υπολογιστή. Τα αρχεία καταγραφής που έχουν διορθωθεί ενδέχεται να εξακολουθούν να περιέχουν ευαίσθητα δεδομένα που δεν εντοπίστηκαν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logs are stored on this PC. Redacted logs may still contain sensitive data that detection missed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros se almacenan en esta PC. Es posible que los registros redactados aún contengan datos confidenciales que no se detectaron."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logid salvestatakse sellesse arvutisse. Redigeeritud logid võivad endiselt sisaldada tundlikke andmeid, mille tuvastamine ei õnnestunud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokit tallennetaan tälle tietokoneelle. Muokatut lokit voivat silti sisältää arkaluontoisia tietoja, jotka tunnistus ei onnistunut."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mga log ay nakaimbak sa PC na ito. Ang mga na-redact na log ay maaari pa ring maglaman ng sensitibong data na hindi natukoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les journaux sont stockés sur ce PC. Les journaux expurgés peuvent toujours contenir des données sensibles qui n’ont pas été détectées."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana adana rajistan ayyukan akan wannan PC. Rubutun da aka sake gyara na iya ƙunsar mahimman bayanai waɗanda aka rasa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יומנים שעברו עריכה עשויים עדיין להכיל נתונים רגישים שפספס הזיהוי. היומנים נשמרים על מחשב זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉग इस पीसी पर संग्रहीत हैं. संशोधित लॉग में अभी भी संवेदनशील डेटा हो सकता है जिसका पता नहीं चल पाया है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnevnici su pohranjeni na ovom računalu. Redigirani zapisnici mogu i dalje sadržavati osjetljive podatke koji nisu otkriveni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A naplók ezen a számítógépen tárolódnak. A módosított naplók továbbra is tartalmazhatnak olyan bizalmas adatokat, amelyek észlelése elmaradt."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Տեղեկամատյանները պահվում են այս համակարգչի վրա: Ռեակտիվացված մատյանները դեռ կարող են պարունակել զգայուն տվյալներ, որոնք հայտնաբերումը բաց է թողել:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log disimpan di PC ini. Log yang disunting mungkin masih berisi data sensitif yang tidak dapat dideteksi."
          }
        },
        "ig-NG" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A na-echekwa ndekọ na PC a. Ndekọ ndị emegharịrị ka nwere ike ịnwe data nwere mmetụta nke furu efu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagskrár eru geymdar á þessari tölvu. Ritfærðar annálar gætu enn innihaldið viðkvæm gögn sem ekki var hægt að finna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I registri vengono archiviati su questo PC. I log redatti potrebbero contenere ancora dati sensibili non rilevati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログはこの PC に保存されます。編集されたログには、検出できなかった機密データが含まれている可能性があります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ჟურნალები ინახება ამ კომპიუტერზე. რედაქტირებული ჟურნალები შეიძლება კვლავ შეიცავდეს სენსიტიურ მონაცემებს, რომლებიც გამოტოვებულია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Журналдар осы компьютерде сақталады. Түзетілген журналдарда әлі де анықталмаған құпия деректер болуы мүмкін."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그는 이 PC에 저장됩니다. 수정된 로그에는 탐지에서 놓친 민감한 데이터가 여전히 포함될 수 있습니다."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logbicher ginn op dësem PC gespäichert. Redaktéiert Logbicher kënnen nach ëmmer sensibel Donnéeën enthalen déi Detektioun verpasst huet."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žurnalai saugomi šiame kompiuteryje. Redaguotuose žurnaluose vis tiek gali būti neskelbtinų duomenų, kurių aptikti nepavyko."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žurnāli tiek glabāti šajā datorā. Rediģētajos žurnālos joprojām var būt ietverti sensitīvi dati, kas netika atklāti."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log disimpan pada PC ini. Log yang disunting mungkin masih mengandungi data sensitif yang terlepas pengesanan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iz-zkuk huma maħżuna fuq dan il-PC. Ir-reġistri skambjati xorta jista' jkun fihom dejta sensittiva li s-sejbien insejt."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logger lagres på denne PC-en. Redakterte logger kan fortsatt inneholde sensitive data som gjenkjenning savnet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logboeken worden op deze pc opgeslagen. Geredigeerde logboeken kunnen nog steeds gevoelige gegevens bevatten die door de detectie zijn gemist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzienniki są przechowywane na tym komputerze. Zredagowane dzienniki mogą nadal zawierać poufne dane, które zostały pominięte podczas wykrywania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os logs são armazenados neste PC. Os logs redigidos ainda podem conter dados confidenciais que não foram detectados pela detecção."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jurnalele sunt stocate pe acest computer. Jurnalele eliminate pot conține în continuare date sensibile pe care le-au ratat detectarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Журналы хранятся на этом компьютере. Отредактированные журналы могут по-прежнему содержать конфиденциальные данные, которые не были обнаружены."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protokoly sú uložené na tomto počítači. Redigované denníky môžu stále obsahovať citlivé údaje, ktoré sa nepodarilo zistiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnevniki so shranjeni na tem računalniku. Redigirani dnevniki lahko še vedno vsebujejo občutljive podatke, ki jih zaznavanje ni zaznalo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regjistrat ruhen në këtë kompjuter. Regjistrimet e redaktuara mund të përmbajnë ende të dhëna të ndjeshme që zbulimi ka humbur."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnevnici se čuvaju na ovom računaru. Redigovani dnevnici mogu i dalje da sadrže osetljive podatke koje je detekcija propustila."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loggar lagras på den här datorn. Redakterade loggar kan fortfarande innehålla känslig data som missade upptäckten."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumbukumbu zimehifadhiwa kwenye Kompyuta hii. Kumbukumbu zilizorekebishwa bado zinaweza kuwa na data nyeti ambayo utambuzi ulikosa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த கணினியில் பதிவுகள் சேமிக்கப்படுகின்றன. திருத்தப்பட்ட பதிவுகளில், கண்டறிதல் தவறவிட்ட முக்கியமான தரவு இன்னும் இருக்கலாம்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกจะถูกจัดเก็บไว้ในพีซีเครื่องนี้ บันทึกที่แก้ไขอาจยังคงมีข้อมูลที่ละเอียดอ่อนซึ่งพลาดการตรวจจับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlükler bu bilgisayarda depolanır. Düzenlenen günlükler hâlâ algılamanın gözden kaçırdığı hassas verileri içerebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Журнали зберігаються на цьому ПК. Відредаговані журнали все ще можуть містити конфіденційні дані, які не були виявлені."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نوشتہ جات اس پی سی پر محفوظ ہیں۔ ترمیم شدہ لاگز میں اب بھی حساس ڈیٹا ہو سکتا ہے جس کا پتہ لگانا چھوٹ گیا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhật ký được lưu trữ trên PC này. Nhật ký được xử lý lại có thể vẫn chứa dữ liệu nhạy cảm mà việc phát hiện bị bỏ sót."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日志存储在此 PC 上。编辑后的日志可能仍包含检测遗漏的敏感数据。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日誌儲存在此 PC 上。編輯後的日誌可能仍包含檢測遺漏的敏感資料。"
          }
        }
      }
    },
