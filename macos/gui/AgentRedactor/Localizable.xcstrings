    "MacQuit_KeepEngine_Message" : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent Redactor toemaak? Die enjin hou aan om in die agtergrond te loop."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنهاء Agent Redactor؟ سيستمر المحرك في العمل في الخلفية."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent Redactor bağlanılsın? Mühərrik arxa planda işləməyə davam edir."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изход от Agent Redactor? Двигателят продължава да работи на заден план."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukončit Agent Redactor? Engine bude dál běžet na pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afslut Agent Redactor? Motoren fortsætter i baggrunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent Redactor beenden? Die Engine läuft im Hintergrund weiter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έξοδος από το Agent Redactor; Η μηχανή συνεχίζει να εκτελείται στο παρασκήνιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quit Agent Redactor? The engine keeps running in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Salir de Agent Redactor? El motor seguirá ejecutándose en segundo plano."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väljuda rakendusest Agent Redactor? Mootor jätkab tööd taustal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lopetetaanko Agent Redactor? Moottori jatkaa toimintaansa taustalla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isara ang Agent Redactor? Patuloy na tatakbo ang engine sa background."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitter Agent Redactor ? Le moteur continue de fonctionner en arrière-plan."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rufe Agent Redactor? Injin zai ci gaba da aiki a bayan fage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לצאת מ-Agent Redactor? המנוע ימשיך לפעול ברקע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent Redactor से बाहर निकलें? इंजन पृष्ठभूमि में चलता रहेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatvoriti Agent Redactor? Engine nastavlja raditi u pozadini."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilép az Agent Redactorból? A motor a háttérben tovább fut."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դուրս գալ Agent Redactor-ից։ Շարժիչը կշարունակի աշխատել խորքում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluar dari Agent Redactor? Mesin tetap berjalan di latar belakang."
          }
        },
        "ig-NG" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pụọ na Agent Redactor? Injin ga-aga n'ihu na-arụ ọrụ n'azụ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hætta í Agent Redactor? Vélinn heldur áfram að keyra í bakgrunni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uscire da Agent Redactor? Il motore continua a funzionare in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent Redactor を終了しますか? エンジンはバックグラウンドで動作し続けます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გამოვიდეთ Agent Redactor-იდან? ძრავა ფონზე განაგრძობს მუშაობას."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent Redactor қолданбасынан шығу керек пе? Қозғалтқыш фонда жұмысын жалғастырады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent Redactor를 종료하시겠습니까? 엔진은 백그라운드에서 계속 실행됩니다."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent Redactor zoumaachen? De Motor leeft am Hannergrond weider."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išeiti iš „Agent Redactor“? Variklis toliau veikia fone."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iziet no Agent Redactor? Dzinējs turpina darboties fonā."
