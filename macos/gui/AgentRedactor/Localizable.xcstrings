        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluar daripada Agent Redactor? Enjin terus berjalan di latar belakang."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oħroġ minn Agent Redactor? Il-magna tibqa' taħdem fl-isfond."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslutte Agent Redactor? Motoren fortsetter å kjøre i bakgrunnen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent Redactor afsluiten? De engine blijft op de achtergrond draaien."
