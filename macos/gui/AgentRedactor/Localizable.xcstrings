    "Dialog_HttpWarning_Message" : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy gebruik 'n HTTP (ongekripteerde) opstroom-URL. Jou API-sleutel sal as plat teks oor die netwerk gestuur word."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت تستخدم عنوان URL الرئيسي لـ HTTP (غير مشفر). سيتم إرسال مفتاح API الخاص بك بنص عادي عبر الشبكة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz HTTP (şifrələnməmiş) yuxarı URL-dən istifadə edirsiniz. API açarınız şəbəkə üzərindən açıq mətnlə göndəriləcək."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използвате HTTP upstream URL (некриптиран). Вашият API ключ ще бъде изпратен като обикновен текст през мрежата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používáte HTTP upstream URL (nešifrované). Váš API klíč bude odeslán po síti jako prostý text."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bruger en HTTP-upstream-URL (ukrypteret). Din API-nøgle sendes i klartekst over netværket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie verwenden eine HTTP- (unverschlüsselte) Upstream-URL. Ihr API-Schlüssel wird im Klartext über das Netzwerk gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείτε HTTP upstream URL (μη κρυπτογραφημένο). Το κλειδί API σας θα σταλεί σε απλό κείμενο μέσω του δικτύου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are using an HTTP (unencrypted) upstream URL. Your API key will be sent in plaintext over the network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está usando una URL upstream HTTP (sin cifrar). Su clave de API se enviará en texto plano por la red."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasutate HTTP upstream URL-i (krüpteerimata). Teie API võti saadetakse võrgu kaudu lihttekstina."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytät HTTP-ylävirta-URL-osoitetta (salaamaton). API-avaimesi lähetetään selkokielisenä verkon yli."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumagamit ka ng HTTP (hindi naka-encrypt) na upstream URL. Ang iyong API key ay ipapadala nang plaintext sa network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous utilisez une URL upstream HTTP (non chiffrée). Votre clé API sera envoyée en clair sur le réseau."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuna amfani da URL na sama (mara ɓoye) HTTP. Za'a aika maɓallin API ɗinku a bayyane akan hanyar sadarwar."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אתה משתמש ב-URL upstream של HTTP (לא מוצפן). מפתח ה-API שלך יישלח כטקסט פשוט דרך הרשת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप एक HTTP (अएन्क्रिप्टेड) अपस्ट्रीम URL का उपयोग कर रहे हैं। आपकी API कुंजी नेटवर्क पर प्लेनटेक्स्ट में भेजी जाएगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristite HTTP upstream URL (nekriptiran). Vaš API ključ bit će poslan kao običan tekst preko mreže."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP upstream URL-t használ (titkosítatlan). Az API kulcsa egyszerű szövegként kerül elküldésre a hálózaton."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
