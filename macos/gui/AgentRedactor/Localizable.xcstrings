    "Dialog_EnableSensitiveInfo_Message" : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit sal ongeredigeerde sensitiewe waardes (name, e-pos, telefoonnommers, ens.) en jou API-sleutel na jou loglêer op skyf skryf. Moenie dit aktiveer as ander toegang tot hierdie rekenaar het nie. Die instelling word teruggestel wanneer jy die toepassing toemaak."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى كتابة قيم حساسة غير منقحة (الأسماء ورسائل البريد الإلكتروني وأرقام الهواتف وما إلى ذلك) ومفتاح واجهة برمجة التطبيقات (API) الخاص بك إلى ملف السجل الخاص بك على القرص. لا تقم بتمكين هذا إذا كان لدى الآخرين حق الوصول إلى هذا الكمبيوتر. تتم إعادة ضبط الإعداد عند إغلاق التطبيق."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, redaktə edilməmiş həssas dəyərləri (adlar, e-poçtlar, telefon nömrələri və s.) və API açarınızı diskdəki log faylınıza yazacaq. Başqalarının bu kompüterə girişi varsa, bunu aktiv etməyin. Proqramı bağladığınız zaman parametr sıfırlanır."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това ще запише нередактирани чувствителни стойности (имена, имейли, телефонни номера и т.н.) и вашия API ключ във вашия лог файл на диска. Не разрешавайте това, ако други имат достъп до този компютър. Настройката се нулира, когато затворите приложението."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To zapíše neredigované citlivé hodnoty (jména, e-maily, telefonní čísla atd.) a váš klíč API do souboru protokolu na disk. Toto nepovolujte, pokud k tomuto počítači mají přístup ostatní. Po zavření aplikace se nastavení resetuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil skrive uredigerede følsomme værdier (navne, e-mails, telefonnumre osv.) og din API-nøgle til din logfil på disken. Aktiver ikke dette, hvis andre har adgang til denne computer. Indstillingen nulstilles, når du lukker appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden nicht geschwärzte vertrauliche Werte (Namen, E-Mails, Telefonnummern usw.) und Ihr API-Schlüssel in Ihre Protokolldatei auf der Festplatte geschrieben. Aktivieren Sie dies nicht, wenn andere Zugriff auf diesen Computer haben. Die Einstellung wird zurückgesetzt, wenn Sie die App schließen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό θα γράψει μη διορθωμένα ευαίσθητες τιμές (ονόματα, email, αριθμούς τηλεφώνου, κ.λπ.) και το κλειδί API σας στο αρχείο καταγραφής σας στο δίσκο. Μην το ενεργοποιήσετε εάν άλλοι έχουν πρόσβαση σε αυτόν τον υπολογιστή. Η ρύθμιση επαναφέρει όταν κλείσετε την εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will write unredacted sensitive values (names, emails, phone numbers, etc.) and your API key to your log file on disk. Do not enable this if others have access to this computer. The setting resets when you close the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto escribirá valores confidenciales no redactados (nombres, correos electrónicos, números de teléfono, etc.) y su clave API en su archivo de registro en el disco. No habilite esto si otras personas tienen acceso a esta computadora. La configuración se restablece cuando cierras la aplicación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See kirjutab redigeerimata tundlikud väärtused (nimed, meilid, telefoninumbrid jne) ja teie API-võtme teie kettale logifaili. Ärge lubage seda, kui teistel on sellele arvutile juurdepääs. Seade lähtestatakse rakenduse sulgemisel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä kirjoittaa muokkaamattomia arkaluonteisia arvoja (nimet, sähköpostiosoitteet, puhelinnumerot jne.) ja API-avaimesi lokitiedostoosi levylle. Älä ota tätä käyttöön, jos muilla on pääsy tähän tietokoneeseen. Asetus nollautuu, kun suljet sovelluksen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isusulat nito ang mga hindi na-redact na sensitibong halaga (mga pangalan, email, numero ng telepono, atbp.) at ang iyong API key sa iyong log file sa disk. Huwag paganahin ito kung ang iba ay may access sa computer na ito. Nire-reset ang setting kapag isinara mo ang app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela écrira les valeurs sensibles non expurgées (noms, e-mails, numéros de téléphone, etc.) et votre clé API dans votre fichier journal sur le disque. Ne l'activez pas si d'autres personnes ont accès à cet ordinateur. Le paramètre est réinitialisé lorsque vous fermez l'application."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wannan zai rubuta ƙima mai mahimmanci (sunaye, imel, lambobin waya, da sauransu) da maɓallin API ɗin ku zuwa fayil ɗin log ɗin ku akan faifai. Kar a kunna wannan idan wasu suna da damar shiga wannan kwamfutar. Saitin yana sake saitawa lokacin da ka rufe ƙa'idar."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו תכתוב ערכים רגישים שלא הוסתרו (שמות, אימיילים, מספרי טלפון וכו') ואת מפתח ה-API שלך לקובץ היומן על הדיסק. אל תפעיל זאת אם לאחרים יש גישה למחשב זה. ההגדרה מתאפסת בעת סגירת האפליקציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह डिस्क पर आपकी लॉग फ़ाइल में असंपादित संवेदनशील मान (नाम, ईमेल, फ़ोन नंबर, आदि) और आपकी एपीआई कुंजी लिखेगा। यदि दूसरों के पास इस कंप्यूटर तक पहुंच है तो इसे सक्षम न करें। जब आप ऐप बंद करते हैं तो सेटिंग रीसेट हो जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo će zapisati neredigirane osjetljive vrijednosti (imena, adrese e-pošte, telefonske brojeve itd.) i vaš API ključ u vašu datoteku dnevnika na disku. Nemojte to omogućiti ako drugi imaju pristup ovom računalu. Postavka se poništava kada zatvorite aplikaciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a módosítatlan bizalmas értékeket (nevek, e-mailek, telefonszámok stb.) és az API-kulcsot a lemezen lévő naplófájlba írja. Ne engedélyezze ezt, ha mások is hozzáférhetnek ehhez a számítógéphez. A beállítás visszaáll az alkalmazás bezárásakor."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սա սկավառակի վրա ձեր գրանցամատյանի ֆայլում կգրի չգրանցված զգայուն արժեքներ (անուններ, էլ. նամակներ, հեռախոսահամարներ և այլն) և ձեր API բանալին: Մի միացրեք սա, եթե ուրիշներն ունեն մուտք դեպի այս համակարգիչ: Կարգավորումը վերականգնվում է, երբ փակում եք հավելվածը:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menulis nilai sensitif yang tidak disunting (nama, email, nomor telepon, dll.) dan kunci API Anda ke file log Anda di disk. Jangan aktifkan ini jika orang lain memiliki akses ke komputer ini. Pengaturan ini diatur ulang ketika Anda menutup aplikasi."
          }
        },
        "ig-NG" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nke a ga-ede ụkpụrụ nwere mmetụta na-adịghị edozi (aha, ozi-e, nọmba ekwentị, wdg) yana igodo API gị na faịlụ log gị na diski. Emela nke a ma ọ bụrụ na ndị ọzọ nwere ohere na kọmputa a. Ntọala ahụ na-atọgharị mgbe imechi ngwa ahụ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þetta mun skrifa óbreytt viðkvæm gildi (nöfn, tölvupóstur, símanúmer o.s.frv.) og API lykilinn þinn í notendaskrána þína á disknum. Ekki virkja þetta ef aðrir hafa aðgang að þessari tölvu. Stillingin endurstillast þegar þú lokar appinu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò scriverà i valori sensibili non oscurati (nomi, e-mail, numeri di telefono, ecc.) e la chiave API nel file di registro su disco. Non abilitarlo se altri hanno accesso a questo computer. L'impostazione si ripristina quando chiudi l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、編集されていない機密値 (名前、電子メール、電話番号など) と API キーがディスク上のログ ファイルに書き込まれます。他の人がこのコンピュータにアクセスできる場合は、これを有効にしないでください。アプリを閉じると設定がリセットされます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეს ჩაწერს არარედაქტირებულ მგრძნობიარე მნიშვნელობებს (სახელები, ელფოსტა, ტელეფონის ნომრები და ა.შ.) და თქვენს API გასაღებს თქვენს ჟურნალის ფაილზე დისკზე. არ ჩართოთ ეს, თუ სხვებს აქვთ წვდომა ამ კომპიუტერზე. პარამეტრი აღდგება აპის დახურვისას."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл өңделмеген құпия мәндерді (аттар, электрондық пошталар, телефон нөмірлері, т.б.) және API кілтін дискідегі журнал файлына жазады. Басқалардың осы компьютерге кіру мүмкіндігі болса, оны қоспаңыз. Параметр қолданбаны жапқанда қалпына келтіріледі."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이렇게 하면 수정되지 않은 민감한 값(이름, 이메일, 전화번호 등)과 API 키가 디스크의 로그 파일에 기록됩니다. 다른 사람이 이 컴퓨터에 액세스할 수 있는 경우에는 이 기능을 활성화하지 마십시오. 앱을 닫으면 설정이 재설정됩니다."
          }
        },
        "lb" : {
