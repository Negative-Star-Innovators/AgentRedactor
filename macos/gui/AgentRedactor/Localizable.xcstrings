        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Съобщенията, съдържащи тези думи, ще бъдат маркирани за редактиране"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zprávy obsahující tato slova budou označeny k redigování"
