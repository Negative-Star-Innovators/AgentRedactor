    "MacPassword_EnableMessage" : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskerm jou gestoorde API-sleutels op hierdie Mac. Jy sal met Touch ID of jou Mac-wagwoord ontsluit. Geen aparte wagwoord benodig nie."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحمي مفاتيح API المخزنة على هذا Mac. ستفتح القفل باستخدام Touch ID أو كلمة مرور Mac. لا حاجة إلى كلمة مرور منفصلة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac-də saxlanılan API açarlarınızı qoruyur. Touch ID və ya Mac parolunuzla kilidi açacaqsınız. Ayrıca parol tələb olunmur."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защитава съхранените ви API ключове на този Mac. Ще отключвате с Touch ID или паролата за Mac. Не е нужна отделна парола."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chráni uložené klíče API na tomto Macu. Odemknout budete pomocí Touch ID nebo hesla k Macu. Samostatné heslo není potřeba."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskytter dine gemte API-nøgler på denne Mac. Du låser op med Touch ID eller din Mac-adgangskode. Der kræves ingen separat adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schützt Ihre gespeicherten API-Schlüssel auf diesem Mac. Sie entsperren mit Touch ID oder Ihrem Mac-Kennwort. Kein separates Kennwort nötig."
