        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stažení modelu se nezdařilo. Zkontrolujte připojení k internetu a zkuste to znovu. Detekce PII není k dispozici, dokud se stahování nedokončí."
