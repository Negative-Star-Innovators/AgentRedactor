    "Dialog_HelloFailed_Message" : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows Hello-verifikasie het nie geslaag nie. Probeer weer, of verlaat die toepassing."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم ينجح التحقق من Windows Hello. حاول مرة أخرى، أو قم بالخروج من التطبيق."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows Hello doğrulaması uğursuz oldu. Yenidən cəhd edin və ya tətbiqdən çıxın."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверката на Windows Hello не успя. Опитайте отново или излезте от приложението."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ověření Windows Hello se nezdařilo. Zkuste to znovu nebo aplikaci ukončete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows Hello-bekræftelse lykkedes ikke. Prøv igen, eller afslut appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Windows Hello-Überprüfung war nicht erfolgreich. Versuchen Sie es erneut oder beenden Sie die App."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επαλήθευση του Windows Hello δεν ήταν επιτυχής. Δοκιμάστε ξανά ή βγείτε από την εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows Hello verification did not succeed. Try again, or exit the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La verificación de Windows Hello no se realizó correctamente. Inténtalo de nuevo o sal de la aplicación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows Hello kinnitamine ei õnnestunud. Proovige uuesti või väljuge rakendusest."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
