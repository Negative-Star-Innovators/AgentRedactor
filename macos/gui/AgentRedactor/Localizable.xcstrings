    "Dialog_DeleteAllLogs_Message" : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit sal die huidige loglêer en alle geargiveerde sessieloglêers permanent uitvee. Dit kan nie ongedaan gemaak word nie."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى حذف ملف السجل الحالي وجميع سجلات الجلسة المؤرشفة نهائيًا. لا يمكن التراجع عن هذا."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, cari jurnal faylını və bütün arxivləşdirilmiş sessiya qeydlərini həmişəlik siləcək. Bu geri qaytarıla bilməz."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това ще изтрие перманентно текущия лог файл и всички архивирани логове от сесии. Не може да бъде отменено."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto trvale smaže aktuální soubor logu a všechny archivované relační logy. Toto nelze vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter den aktuelle logfil og alle arkiverede sessionslogfiler permanent. Dette kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies löscht dauerhaft die aktuelle Protokolldatei und alle archivierten Sitzungsprotokolle. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό θα διαγράψει μόνιμα το τρέχον αρχείο καταγραφής και όλα τα αρχειοθετημένα αρχεία συνεδριών. Δεν μπορεί να αναιρεθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will permanently delete the current log file and all archived session logs. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará permanentemente el archivo de registro actual y todos los registros de sesión archivados. No se puede deshacer."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See kustutab jäädavalt praeguse logifaili ja kõik arhiveeritud seansilogid. Seda ei saa tagasi võtta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä poistaa nykyisen lokitiedoston ja kaikki arkistoidut istuntolokit pysyvästi. Tätä ei voi perua."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanente nitong buburahin ang kasalukuyang log file at lahat ng naka-archive na session logs. Hindi ito maibabalik."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera définitivement le fichier journal actuel et tous les journaux de session archivés. Cette action est irréversible."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wannan zai share fayil ɗin log ɗin na yanzu da duk bayanan zaman da aka adana har abada. Ba za a iya soke wannan ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו תמחק לצמיתות את קובץ היומן הנוכחי ואת כל יומני ההפעלה המאוחסנים. לא ניתן לבטל זאת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह वर्तमान लॉग फ़ाइल और सभी संग्रहीत सत्र लॉग को स्थायी रूप से हटा देगा। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo će trajno izbrisati trenutnu datoteku dnevnika i sve arhivirane dnevnike sesija. Ne može se poništiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez véglegesen törli az aktuális naplófájlt és az összes archivált munkamenet-naplót. Ez nem vonható vissza."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Այն մշտապես կջնջի ընթացիկ մատյանի ֆայլը և բոլոր արխիվացված նստաշրջանների մատյանները: Այն հնարավոր չէ հետարկել:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini akan menghapus file log saat ini dan semua log sesi yang diarsipkan secara permanen. Tidak dapat dibatalkan."
          }
        },
        "ig-NG" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nke a ga-ebibi log file ugbu a na logs niile e chekwara nke ọma. Enweghị ike ịmegharị ya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þetta eyðir fyrirvaralaust núverandi skráarskrá og öllum vistuðu lotuskrám. Ekki er hægt að afturkalla þetta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo eliminerà definitivamente il file di log attuale e tutti i log di sessione archiviati. Non può essere annullato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のログファイルとすべてのアーカイブ済みセッション ログが完全に削除されます。この操作は元に戻せません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეს მიმდინარე ჟურნალის ფაილს და ყველა არქივირებულ სეანსის ჟურნალს სამუდამოდ წაშლის. ეს ვერ მოხერხდება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл ағымдағы журнал файлын және барлық мұрағатталған сеанс журналдарын біржола жояды. Бұл әрекетті қайтару мүмкін емес."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 로그 파일과 모든 보관된 세션 로그가 영구적으로 삭제됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dëst läscht de aktuelle Logfichier an all archivéiert Sitzungslogfichieren definitiv. Kann net réckgängeg gemaach ginn."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai visam laikui ištrins dabartinį žurnalo failą ir visus archyvuotus sesijų žurnalus. To nebus galima atšaukti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas neatgriezeniski izdzēsīs pašreizējo žurnāla failu un visus arhivētos sesiju žurnālus. To nevar atsaukt."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan memadamkan fail log semasa dan semua log sesi yang diarkibkan secara kekal. Ini tidak boleh dibuat asal."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dan se jħassar il-log file attwali u l-logs tas-sessjoni arkivjati kollha b'mod permanenti. Ma jistax jitneħħa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter gjeldende loggfil og alle arkiverte øktlogger permanent. Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit verwijdert het huidige logbestand en alle gearchiveerde sessielogboeken permanent. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To trwale usunie bieżący plik dziennika i wszystkie zarchiwizowane dzienniki sesji. Tej operacji nie można cofnąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto irá eliminar permanentemente o ficheiro de registo atual e todos os registos de sessão arquivados. Não pode ser anulado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceasta va șterge permanent fișierul jurnal curent și toate jurnalele de sesiune arhivate. Nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут безвозвратно удалены текущий файл журнала и все архивированные журналы сеансов. Это нельзя отменить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto natrvalo odstráni aktuálny súbor logu a všetky archivované relačné logy. Toto nemožno vrátiť späť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To bo trajno izbrisalo trenutno dnevniško datoteko in vse arhivirane dnevnike sej. Tega ni mogoče razveljaviti."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjo do të fshijë përgjithmonë skedarin aktual të regjistrave dhe të gjitha regjistrat e arkivuara të seancave. Nuk mund të zhbëhet."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo će trajno obrisati trenutnu datoteku dnevnika i sve arhivirane dnevnike sesija. Ne može se poništiti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta tar permanent bort den aktuella loggfilen och alla arkiverade sessionsloggar. Detta kan inte ångras."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hii itafuta faili la kumbukumbu la sasa na kumbukumbu zote za vikao vilivyohifadhiwa kwa kudumu. Haiwezi kufutwa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இது தற்போதைய பதிவு கோப்பு மற்றும் அனைத்து காப்பகப்படுத்தப்பட்ட அமர்வு பதிவுகளையும் நிரந்தரமாக நீக்கும். இதை செயல்தவிர்க்க முடியாது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดำเนินการนี้จะลบไฟล์บันทึกปัจจุบันและบันทึกเซสชันที่เก็บถาวรทั้งหมดอย่างถาวร ไม่สามารถย้อนกลับได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem mevcut günlük dosyasını ve tüm arşivlenmiş oturum günlüklerini kalıcı olarak silecektir. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це назавжди видалить поточний файл журналу та всі архівовані журнали сеансів. Це не можна скасувати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ موجودہ لاگ فائل اور تمام محفوظ کردہ سیشن لاگز کو مستقل طور پر حذف کر دے گا۔ اسے کالعدم نہیں کیا جا سکتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ xóa vĩnh viễn tệp nhật ký hiện tại và tất cả nhật ký phiên đã lưu trữ. Không thể hoàn tác."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除当前日志文件和所有已归档的会话日志。无法撤销。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將永久刪除目前記錄檔和所有已封存的作業記錄。無法復原。"
          }
        }
      }
    },
