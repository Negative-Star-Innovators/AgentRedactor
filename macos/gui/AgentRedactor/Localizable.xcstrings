    "HomePage_Keywords_Description.Text" : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boodskappe wat hierdie woorde bevat, sal gemerk word vir redigering"
          }
