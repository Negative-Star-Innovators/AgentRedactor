          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fungua kwa Touch ID au nenosiri lako la Mac kuendelea."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தொடர Touch ID அல்லது உங்கள் Mac கடவுச்சொல்லுடன் திறக்கவும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปลดล็อกด้วย Touch ID หรือรหัสผ่าน Mac ของคุณเพื่อดำเนินการต่อ"
          }
