            "state" : "translated",
            "value" : "更新を確認できませんでした。後でもう一度お試しください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "განახლებების შემოწმება ვერ მოხერხდა. სცადეთ მოგვიანებით."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жаңартуларды тексеру мүмкін болмады. Кейінірек қайталап көріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트를 확인할 수 없습니다. 나중에 다시 시도하세요."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et konnt net no Updates gesicht ginn. Probéiert et méi spéit nach eng Kéier."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko patikrinti naujinimų. Bandykite dar kartą vėliau."
