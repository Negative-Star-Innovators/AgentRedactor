            "value" : "விண்டோஸ் ஹலோ சரிபார்ப்பு முடிக்கப்படவில்லை, எனவே பாதுகாப்பு இன்னும் இயக்கப்பட்டுள்ளது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การตรวจสอบ Windows Hello ยังไม่เสร็จสมบูรณ์ ดังนั้นการป้องกันจึงยังคงเปิดใช้งานอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows Hello doğrulaması tamamlanmadığından koruma hâlâ etkindir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірку Windows Hello не завершено, тому захист усе ще ввімкнено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ونڈوز ہیلو کی توثیق مکمل نہیں ہوئی تھی، لہذا تحفظ اب بھی فعال ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá trình xác minh Windows Hello chưa hoàn tất nên tính năng bảo vệ vẫn được bật."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows Hello 验证尚未完成，因此保护仍处于启用状态。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows Hello 驗證尚未完成，因此保護仍處於啟用狀態。"
          }
        }
      }
    },
