    "Dialog_Quit_Message" : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As jy toemaak, sal Agent Redactor nie meer API-verkeer monitor en redigeer nie."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا قمت بالخروج، فلن يقوم Agent Redactor بمراقبة حركة مرور واجهة برمجة التطبيقات (API) وتنقيحها بعد ذلك."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Əgər çıxsanız, Agent Redactor artıq API trafikinə nəzarət etməyəcək və redaktə etməyəcək."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако излезете, Agent Redactor повече няма да следи и редактира API трафика."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud ukončíte, Agent Redactor již nebude sledovat a redigovat API provoz."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du afslutter, overvåger og redigerer Agent Redactor ikke længere API-trafik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie beenden, überwacht und schwärzt Agent Redactor keinen API-Datenverkehr mehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εάν κλείσετε, το Agent Redactor δεν θα παρακολουθεί και δεν θα αποκρύπτει πλέον την κίνηση API."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you quit, Agent Redactor will no longer monitor and redact API traffic."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sale, Agent Redactor ya no supervisará ni redactará el tráfico de API."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui väljute, ei jälgi ega redigeeri Agent Redactor enam API liiklust."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos lopetat, Agent Redactor ei enää valvo ja peitä API-liikennettä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kung lalabas ka, hindi na mamomonitor at ire-redact ng Agent Redactor ang API traffic."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous quittez, Agent Redactor ne surveillera et ne masquera plus le trafic API."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idan kun daina, Agent Redactor ba zai ƙara saka idanu da rage zirga-zirgar API ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם תצא, Agent Redactor לא ימשיך לפקח ולערוך את תעבורת ה-API."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि आप बाहर निकलते हैं, तो Agent Redactor API ट्रैफ़िक की निगरानी और रिडैक्शन नहीं करेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako izađete, Agent Redactor više neće nadzirati i maskirati API promet."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha kilép, az Agent Redactor többé nem figyeli és nem anonimizálja az API-forgalmat."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Եթե դուրս գաք, Agent Redactor-ը այլևս չի հսկի և չի ջնջի API տրաֆիկը:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Anda keluar, Agent Redactor tidak akan lagi memantau dan menyunting lalu lintas API."
          }
        },
        "ig-NG" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ị pụrụ, Agent Redactor agaghị azọ akwa ma ọ bụ emebi emebi API traffic."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ef þú hættir mun Agent Redactor ekki lengur fylgjast með og afskrá API umferð."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se esci, Agent Redactor non monitorerà e non redigerà più il traffico API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了すると、Agent Redactor は API トラフィックの監視と編集を行わなくなります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თუ გამოხვალთ, Agent Redactor აღარ დააკვირდება და არ წაშლის API ტრაფიკს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шығарсаңыз, Agent Redactor API трафигін бақылап, өңдемейді."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
