        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskeder, der indeholder disse ord, markeres til redigering"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachrichten, die diese Wörter enthalten, werden zur Schwärzung markiert"
