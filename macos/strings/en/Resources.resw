<?xml version="1.0" encoding="utf-8"?>
<!-- macOS-only UI strings (SwiftUI GUI). These exist only on macOS, so there
     is no Windows counterpart in windows/Strings/. Same .resw format and
     LocFormat placeholder conventions ({0}, {1}, ...). To translate one of
     these keys into another language, add a Resources.resw for that language
     in a sibling directory (e.g. macos/strings/de/Resources.resw) with the
     same key names — resw_to_xcstrings.py merges macos/strings/ overlays on
     top of the windows/Strings/ catalogs. -->
<root>
  <resheader name="resmimetype"><value>text/microsoft-resx</value></resheader>
  <resheader name="version"><value>2.0</value></resheader>
  <resheader name="reader"><value>System.Resources.ResXResourceReader, System.Windows.Forms</value></resheader>
  <resheader name="writer"><value>System.Resources.ResXResourceWriter, System.Windows.Forms</value></resheader>
  <data name="MacEngine_NotRunning" xml:space="preserve"><value>Engine is not running — retrying…</value></data>
