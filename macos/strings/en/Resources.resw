  <data name="MacSettings_StartOnLogin" xml:space="preserve"><value>Open at Login</value></data>
  <data name="MacStats_Format" xml:space="preserve"><value>Requests: {0}   PII: {1}   Regex: {2}   Keywords: {3}</value></data>
