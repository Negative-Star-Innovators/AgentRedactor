<Page
    x:Class="AgentRedactor.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Profile List -->
        <Grid x:Name="LeftPanel" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="ProfilesHeader" FontSize="16" FontWeight="SemiBold" Margin="16,16,16,8"/>

            <ListView x:Name="ProfileList" Grid.Row="1" Margin="8,0,8,8" SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,8"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,0,8,16" Spacing="8">
                <Button x:Name="AddProfileBtn" Padding="16,4"/>
                <Button x:Name="RemoveProfileBtn" Padding="16,4"/>
            </StackPanel>
        </Grid>

        <!-- Right Column: Scrollable Content -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="24" Spacing="16" HorizontalAlignment="Stretch">

                <!-- Quick Start Card -->
                <Border x:Name="QuickStartBorder" CornerRadius="8" BorderThickness="1" Padding="20">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="QuickStartTitle" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="QuickStartStep1" TextWrapping="Wrap"/>
                        <TextBlock x:Name="QuickStartStep2" TextWrapping="Wrap"/>
                        <TextBlock x:Name="QuickStartStep3" TextWrapping="Wrap"/>

                    </StackPanel>
                </Border>

                <!-- API Proxy Card -->
                <Border x:Name="ProfileCardBorder" CornerRadius="8" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="ApiProxyTitle" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="ProfileNameLabel" VerticalAlignment="Center" Margin="0,0,12,8"/>
                        <TextBox x:Name="ProfileNameBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LocalUrlLabel" VerticalAlignment="Center" Margin="0,0,12,8"/>
                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="http://localhost:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="PortBox" Width="72" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="/" VerticalAlignment="Center"/>
                            <Button Grid.Row="0" Grid.Column="3" x:Name="CopyUrlBtn" Padding="8,2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" FontSize="11" Opacity="0.6" x:Name="LocalUrlHint" Margin="0,2,0,0"/>
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0" x:Name="ForwardToLabel" VerticalAlignment="Top" Margin="0,4,12,8"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Spacing="2" Margin="0,0,0,8">
                            <TextBox x:Name="UrlBox" HorizontalAlignment="Stretch"/>
                            <TextBlock FontSize="11" Opacity="0.6" x:Name="ForwardToHint"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" x:Name="ApiKeyLabel" VerticalAlignment="Top" Margin="0,8,12,8"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Spacing="4" Margin="0,0,0,8">
                            <PasswordBox x:Name="ApiKeyBox" HorizontalAlignment="Stretch"/>
                            <CheckBox x:Name="ShowKeyCheck" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProxyStatusBlock" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button x:Name="SaveProfileBtn" Grid.Column="1" Padding="20,6"/>
                        </Grid>
                    </Grid>
                    </StackPanel>
                </Border>

                <!-- Regex Patterns Card -->
                <Border x:Name="RegexCardBorder" CornerRadius="8" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="RegexTitle" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock FontSize="12" Opacity="0.6" Margin="0,0,0,12" x:Name="RegexDescription"/>
                        <Grid x:Name="RegexHeaderGrid" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RegexEnabledHeader" FontWeight="SemiBold" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="RegexPatternHeader" FontWeight="SemiBold" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="RegexListPanel" Spacing="2" MaxHeight="150"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewRegexBox" VerticalAlignment="Center" HorizontalAlignment="Stretch" Grid.Column="0" Margin="0,0,8,0"/>
                            <Button x:Name="AddRegexBtn" VerticalAlignment="Center" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Keywords Card -->
                <Border x:Name="KeywordCardBorder" CornerRadius="8" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="KeywordsTitle" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock FontSize="12" Opacity="0.6" Margin="0,0,0,12" x:Name="KeywordsDescription"/>
                        <Grid x:Name="KeywordHeaderGrid" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="KeywordsEnabledHeader" FontWeight="SemiBold" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="KeywordsCaseHeader" FontWeight="SemiBold" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="KeywordsKeywordHeader" FontWeight="SemiBold" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="KeywordListPanel" Spacing="2" MaxHeight="150"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="NewKeywordBox" VerticalAlignment="Center" HorizontalAlignment="Stretch" Grid.Column="0" Grid.Row="0" Margin="0,0,8,0"/>
                            <Button x:Name="AddKeywordBtn" VerticalAlignment="Center" Grid.Column="1" Grid.Row="0"/>
                            <CheckBox x:Name="CaseSensitiveCheck" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sensitive Data Detection Card -->
                <Border x:Name="SecurityCardBorder" CornerRadius="8" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="DetectionTitle" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock FontSize="12" Opacity="0.6" Margin="0,0,0,12" x:Name="DetectionDescription" TextWrapping="Wrap"/>
                        <ToggleSwitch x:Name="UseOpenAISwitch" Margin="0,0,0,4"/>
                        <TextBlock FontSize="11" Opacity="0.6" x:Name="DetectionSlowWarning" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="DetectionConfidenceLabel" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Opacity="0.8"/>
                            <TextBox Grid.Column="1" x:Name="ConfidenceThresholdBox" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="PiiGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Password Card -->
                <Border x:Name="PasswordCardBorder" CornerRadius="8" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="PasswordTitle" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="RequirePasswordCheck"/>
                        <Button x:Name="ChangePasswordBtn" Margin="0,8,0,0" Padding="16,4"/>
                    </StackPanel>
                </Border>

                <!-- Statistics Card -->
                <Border x:Name="StatusCardBorder" CornerRadius="8" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatisticsTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button x:Name="ClearStatisticsBtn" Grid.Column="1" Padding="12,4" Click="ClearStatisticsBtn_Click"/>
                        </Grid>
                        <TextBlock x:Name="StatsBlock" FontSize="14" Margin="0,8,0,8"/>
                        <TextBlock x:Name="StatusBlock" FontSize="13" FontStyle="Italic" Opacity="0.6"/>
                    </StackPanel>
                </Border>

                <!-- Session Matches Card -->
                <Border x:Name="MatchesCardBorder" CornerRadius="8" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SessionRedactionsTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button x:Name="ClearMatchesBtn" Grid.Column="1" Padding="12,4" Click="ClearMatchesBtn_Click"/>
                        </Grid>
                        <TextBlock FontSize="12" Opacity="0.6" Margin="0,4,0,8" x:Name="SessionRedactionsDescription"/>
                        <ListView x:Name="MatchesList" MaxHeight="150" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Logs Card -->
                <Border x:Name="LogsCardBorder" CornerRadius="8" BorderThickness="1" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LogsTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Row="0" Grid.ColumnSpan="2"/>
                        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,0,0" Spacing="4">
                            <CheckBox x:Name="EnableLoggingCheck"/>
                            <CheckBox x:Name="ShowSensitiveCheck"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <HyperlinkButton x:Name="OpenLogBtn" VerticalAlignment="Center"/>
                            <HyperlinkButton x:Name="OpenFolderBtn" VerticalAlignment="Center"/>
                            <Button x:Name="ClearLogsBtn" Padding="12,4" Click="ClearLogsBtn_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="LogsDisclaimer" Grid.Row="2" Grid.ColumnSpan="2" FontSize="11" Opacity="0.6" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>